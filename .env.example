# =============================================================================
# NightForge LeadForge — environment variables
# Copy to .env (`cp .env.example .env`). Never commit .env.
# Keys can also be pasted into the Streamlit prototype UI (`streamlit run app.py`).
# =============================================================================

# --- LLM (required for a live run; sample mode works without a key) ---
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional providers (set LEADFORGE_LLM_PROVIDER accordingly)
ANTHROPIC_API_KEY=
XAI_API_KEY=

LEADFORGE_LLM_PROVIDER=openai
LEADFORGE_MODEL=gpt-4o-mini

# --- Search (recommended for live discovery; sample mode does not need these) ---
# Tavily: https://tavily.com (1000 searches/month free)
TAVILY_API_KEY=

# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=

# If neither is set, live discovery falls back to DuckDuckGo (no key, less reliable)

# --- Target market ---
LEADFORGE_TARGET_ZIP=85001
LEADFORGE_TARGET_LOCATION=
LEADFORGE_TARGET_INDUSTRIES=HVAC,plumbing,electrical,roofing,general contractor,garage doors,pest control,auto repair

# --- Guardrails (recommended $8 cap; hard ceiling $10) ---
LEADFORGE_MAX_LEADS=30
LEADFORGE_BUDGET_USD=8.0
LEADFORGE_STOP_PROJECTED_USD=7.25
LEADFORGE_PARALLEL_RESEARCH=6

# --- NightForge API process settings (prefix NIGHTFORGE_) ---
NIGHTFORGE_ENVIRONMENT=development
NIGHTFORGE_HOST=127.0.0.1
NIGHTFORGE_PORT=8000
NIGHTFORGE_LOG_LEVEL=info

# --- Jobber webhook verification (fail closed if unset) ---
# Do not invent a value. Leave empty unless you have a real Jobber client secret.
JOBBER_WEBHOOK_SECRET=

# --- Optional: Google Sheets export (prototype) ---
GOOGLE_SHEETS_CREDENTIALS_JSON=./credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=LeadForge Output

# --- Telemetry (optional, reduces noise) ---
CREWAI_TELEMETRY=false
OTEL_SDK_DISABLED=true
